TESTBENCH CODE

`timescale 1ns/1ps

module tb_hybrid_bf16_dcim_macro;

    parameter ADDR_WIDTH   = 3;
    parameter DATA_WIDTH   = 16;
    parameter CLOCK_PERIOD = 10;

    //--------------------------------------------------------------
    // DUT inputs
    //--------------------------------------------------------------

    reg clk;
    reg reset_n;

    reg write_request;
    reg read_request;
    reg compute_request;
    reg accumulate_enable;
    reg accumulate_clear_request;

    reg [ADDR_WIDTH-1:0] address;
    reg [DATA_WIDTH-1:0] write_data;
    reg [DATA_WIDTH-1:0] activation_data;

    reg [1:0] precision_mode;

    //--------------------------------------------------------------
    // DUT outputs
    //--------------------------------------------------------------

    wire [DATA_WIDTH-1:0] read_data;
    wire [DATA_WIDTH-1:0] compute_result;

    wire compute_valid;
    wire [15:0]accumulated_result;
    wire accumulator_valid;

    wire busy;

    //--------------------------------------------------------------
    // DUT
    //--------------------------------------------------------------

    hybrid_bf16_dcim_macro #(
        .ADDR_WIDTH (ADDR_WIDTH)
    ) dut (
        .clk               (clk),
        .reset_n           (reset_n),

        .write_request     (write_request),
        .read_request      (read_request),
        .compute_request   (compute_request),
        .accumulate_enable (accumulate_enable),
        .accumulator_clear_request (accumulate_clear_request),

        .address           (address),
        .write_data        (write_data),
        .external_operand_b   (activation_data),

        .precision_mode    (precision_mode),

        .read_data         (read_data),
        .compute_result    (compute_result),

        .read_valid        (read_valid),
        .compute_valid     (compute_valid),

        .accumulated_result (accumulated_result),
        .accumulator_valid (accumulator_valid),

        .busy              (busy)
    );

    //--------------------------------------------------------------
    // Clock
    //--------------------------------------------------------------

    initial begin
        clk = 1'b0;
    end

    always #(CLOCK_PERIOD / 2) begin
        clk = ~clk;
    end

    //--------------------------------------------------------------
    // Reset task
    //--------------------------------------------------------------

    task apply_reset;
        begin

            reset_n = 1'b0;

            repeat (3)
                @(posedge clk);

            reset_n = 1'b1;

            @(posedge clk);
        end
    endtask

    //--------------------------------------------------------------
    // Write task
    //--------------------------------------------------------------

    task write_memory_word;

        input [ADDR_WIDTH-1:0] memory_address;
        input [DATA_WIDTH-1:0] memory_data;

        begin

            wait (busy == 1'b0);

            @(negedge clk);

            address       = memory_address;
            write_data    = memory_data;
            write_request = 1'b1;

            @(negedge clk);

            write_request = 1'b0;

            wait (busy == 1'b0);

            $display(
                "T=%0t WRITE address=%0d data=%h",
                $time,
                memory_address,
                memory_data
            );
        end
    endtask

    //--------------------------------------------------------------
    // Read task
    //--------------------------------------------------------------

    task read_memory_word;

        input [ADDR_WIDTH-1:0] memory_address;

        begin

            wait (busy == 1'b0);

            @(negedge clk);

            address      = memory_address;
            read_request = 1'b1;

            @(negedge clk);

            read_request = 1'b0;

            wait (read_valid == 1'b1);

            $display(
                "T=%0t READ address=%0d data=%h",
                $time,
                memory_address,
                read_data
            );

            wait (busy == 1'b0);
        end
    endtask

    //--------------------------------------------------------------
    // Compute task
    //--------------------------------------------------------------

    task perform_computation;

        input [ADDR_WIDTH-1:0] weight_address;
        input [DATA_WIDTH-1:0] activation;
        input [1:0]            mode;

        begin

            wait (busy == 1'b0);

            @(negedge clk);

            address           = weight_address;
            activation_data   = activation;
            precision_mode    = mode;
            accumulate_enable = 1'b1;
            compute_request   = 1'b1;

            @(negedge clk);

            compute_request = 1'b0;

            wait (compute_valid == 1'b1);

            $display(
                "T=%0t COMPUTE mode=%b activation=%h result=%h",
                $time,
                mode,
                activation,
                compute_result
            );

            wait (busy == 1'b0);
        end
    endtask

    //--------------------------------------------------------------
    // Test sequence
    //--------------------------------------------------------------

    initial begin

        reset_n           = 1'b0;

        write_request     = 1'b0;
        read_request      = 1'b0;
        compute_request   = 1'b0;
        accumulate_enable = 1'b0;

        address           = {ADDR_WIDTH{1'b0}};
        write_data        = {DATA_WIDTH{1'b0}};
        activation_data   = {DATA_WIDTH{1'b0}};

        precision_mode = 2'b00;

        //----------------------------------------------------------
        // Apply reset
        //----------------------------------------------------------

        apply_reset;

        //----------------------------------------------------------
        // BF16 reference values
        //
        // 1.0 = 16'h3F80
        // 1.5 = 16'h3FC0
        // 2.0 = 16'h4000
        // 3.0 = 16'h4040
        //----------------------------------------------------------

        //----------------------------------------------------------
        // Store 1.5 at address zero
        //----------------------------------------------------------

        write_memory_word(
            3'd0,
            16'h3FC0
        );

        //----------------------------------------------------------
        // Read stored value
        //----------------------------------------------------------

        read_memory_word(
            3'd0
        );

        //----------------------------------------------------------
        // Multiply stored 1.5 by activation 2.0
        //----------------------------------------------------------

        // Full 8 x 8 mode
        perform_computation(
            3'd0,
            16'h4000,
            2'b00
        );

        // Medium 6 x 6 mode
        perform_computation(
            3'd0,
            16'h4000,
            2'b01
        );

        // Low-power 4 x 4 mode
        perform_computation(
            3'd0,
            16'h4000,
            2'b10
        );

        //----------------------------------------------------------
        // Additional memory test
        //----------------------------------------------------------

        write_memory_word(
            3'd1,
            16'h3F80
        );

        write_memory_word(
            3'd2,
            16'h4000
        );

        read_memory_word(
            3'd1
        );

        read_memory_word(
            3'd2
        );

        //----------------------------------------------------------
        // Finish
        //----------------------------------------------------------

        repeat (5)
            @(posedge clk);

        $display("Simulation completed successfully.");

        $finish;
    end

    //--------------------------------------------------------------
    // Timeout
    //--------------------------------------------------------------

    initial begin

        #5000;

        $display("ERROR: Simulation timeout.");

        $finish;
    end

endmodule
